{block menu}
	{control menu}
{/block}

{block content}
<div class="container">

	<article class="stamp-detail-page">
		<figure class="stamp-detail-image">
			<a n:if="$stamp['image']" data-fslightbox href="{$baseUrl}/images/stamps/{$stamp['image']}" target="_blank">
				<img src="{$baseUrl}/images/stamps/{$stamp['image']}" alt="{$stamp['name']}">
			</a>
			<div n:if="!$stamp['image']" class="stamp-image">
				<span class="icon is-large text-muted" title="{_'stamp.noImage'}">
					<i class="fas fa-4x fa-image"></i>
				</span>
			</div>
		</figure>
		<p class="stamp-detail-number">{_'detail.stampNumber{number}', ['number' => '#' . $stamp['id']]}</p>
		<h1 class="title is-3">{$stamp['name']}</h1>

		<section class="stamp-detail-collection" n:snippet="detailCollection">
			{var $collected = $collection[$stamp['id']] ?? null}
			{if $collected}
				<div class="stamp-detail-collected">
					<span class="icon has-text-success" aria-hidden="true"><i class="fas fa-lg fa-check"></i></span>
					<div class="stamp-detail-collected-text">
						<p class="has-text-weight-semibold">{if $collected->date !== null}{_'detail.inCollectionSince{date}', ['date' => $collected->date->format('j. n. Y')]}{else}{_'detail.inCollection'}{/if}</p>
						<p n:if="$collected->comment">{$collected->comment|breaklines}</p>
					</div>
					{include "../@collectButton.latte", stamp => $stamp, collection => $collection, class => 'button is-light', label => ('stamp.sheet.edit'|translate)}
				</div>
			{elseif $user->isLoggedIn()}
				{include "../@collectButton.latte", stamp => $stamp, collection => $collection, class => 'button is-link is-fullwidth', label => ('stamp.collect'|translate)}
			{/if}
		</section>

		{* the nearest sales point, the others collapsed (#80) *}
		<section n:if="$salespointItems" class="stamp-detail-section">
			<h2 class="title is-5">{_'detail.salespoints'}</h2>
			<ul class="stamp-detail-salespoints">
				{include salespoint, item => $salespointItems[0]}
			</ul>
			<details n:if="count($salespointItems) > 1" class="stamp-detail-salespoints-more">
				<summary>{_'detail.moreSalespoints{count}', ['count' => count($salespointItems) - 1]}</summary>
				<ul class="stamp-detail-salespoints">
					{foreach array_slice($salespointItems, 1) as $item}
						{include salespoint, item => $item}
					{/foreach}
				</ul>
			</details>
		</section>

		{* the full text without JS; bundle.js shortens it to a few lines with a button to expand it *}
		<section n:if="$stamp['description']" class="stamp-detail-section">
			<h2 class="title is-5">{_'detail.about'}</h2>
			<div class="stamp-description js-description" id="stamp-description">{$stamp['description']|breaklines}</div>
			<button type="button" class="button is-small is-text stamp-description-toggle js-description-toggle" hidden aria-expanded="false" aria-controls="stamp-description" data-more="{_'detail.showFullDescription'}" data-less="{_'detail.showLessDescription'}">{_'detail.showFullDescription'}</button>
		</section>

		<div id="map" class="stamp-detail-map"></div>

		<div n:if="$stamp['website'] || $stamp['wikipedia'] || $stamp['facebook'] || $stamp['detail_url']" class="stamp-detail-links">
			<a n:if="$stamp['website']" href="{$stamp['website']}" target="_blank" rel="noopener">{_'detail.website'}</a>
			<a n:if="$stamp['wikipedia']" href="{$stamp['wikipedia']}" target="_blank" rel="noopener">Wikipedia</a>
			<a n:if="$stamp['facebook']" href="{$stamp['facebook']}" target="_blank" rel="noopener">Facebook</a>
			<span n:if="$stamp['detail_url']">
				{_'detail.detailsOn'}
				<a href="{$stamp['detail_url']}" target="_blank" rel="noopener">Turistické známky.cz</a>
			</span>
		</div>
	</article>

	<section n:if="$closest" class="stamp-detail-page stamp-detail-section">
		<h2 class="title is-5">{_'detail.nearby'}</h2>
		{snippetArea stamps}
			<ul class="stamp-rows">
				<li n:foreach="$closest as $closestStamp">
					{include "../@stampRow.latte", stamp => $closestStamp, collection => $collection}
				</li>
			</ul>
		{/snippetArea}
	</section>

	<div n:snippet="collectSheet">{include "../@collectSheet.latte"}</div>
</div>

{/block}

<script n:syntax="double" n:block=userScript>
	const API_KEY = {{$mapyApiKey}};
	{{var $allStamps = array_merge([$stamp->toArray()], array_values($closest))}}
	{{var $salespointMarkers = array_values(array_filter(array_map(fn($salespoint) => $salespoint->toArray(), $salespoints), fn($salespoint) => $salespoint['lat'] !== null && $salespoint['lng'] !== null))}}
	initDescription(); // first, a failing map must not leave the description shortened without its button
	new StampMap('map', {{$allStamps}}, {{$collection}}, {{$stamp['lat']}}, {{$stamp['lng']}}, {{$baseUrl}}, API_KEY, {{$salespointMarkers}});
</script>


{define salespoint}
	{var $salespoint = $item['salespoint']}
	<li n:class="$salespoint['system'] ? 'text-muted is-italic'">
		<div class="stamp-detail-salespoint-text">
			<span>{$salespoint['name']}</span>
			<span n:if="$item['distance']" class="stamp-detail-salespoint-distance text-muted">{$item['distance']}</span>
		</div>
		<a n:if="$salespoint['website']" href="{$salespoint['website']}" target="_blank" rel="noopener">{_'detail.website'}</a>
		<a n:if="$item['navigate']" href="{$item['navigate']}" target="_blank" rel="noopener" class="stamp-detail-salespoint-navigate">{_'detail.navigate'}</a>
	</li>
{/define}
