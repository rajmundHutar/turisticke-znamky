{block menu}
	{control menu}
{/block}

{block content}
{var $isCollected = (bool)($collection[$stamp['id']] ?? false)}
<div class="container">

	<div class="columns">
		<div class="column is-one-third px-6">
			<figure class="image">
				<div n:if="$isCollected" class="ribbon ribbon-top-right">
							<span>
								{_'stamp.collected'}
							</span>
				</div>
				<a n:if="$stamp['image']" data-fslightbox href="{$baseUrl}/images/stamps/{$stamp['image']}" target="_blank">
					<img src="{$baseUrl}/images/stamps/{$stamp['image']}" alt="{$stamp['name']}" loading="lazy">
				</a>
				<div n:if="!$stamp['image']" class="stamp-image">
					<span class="icon is-large has-text-grey-lighter" title="{_'stamp.noImage'}">
						<i class="fas fa-4x fa-image"></i>
					</span>
				</div>
			</figure>
		</div>
		<div class="column px-6">
			<div class="content">
				<p class="title is-3">
					{$stamp['id']} - {$stamp['name']}
				</p>
			</div>
			<div n:if="$stamp['description']" class="content">
				<p>{$stamp['description']|breaklines}</p>
			</div>
			<div n:if="$stamp['website'] || $stamp['wikipedia'] || $stamp['facebook']" class="content">
				<a n:if="$stamp['website']" href="{$stamp['website']}" target="_blank" rel="noopener" class="mr-4">{_'detail.website'}</a>
				<a n:if="$stamp['wikipedia']" href="{$stamp['wikipedia']}" target="_blank" rel="noopener" class="mr-4">Wikipedia</a>
				<a n:if="$stamp['facebook']" href="{$stamp['facebook']}" target="_blank" rel="noopener">Facebook</a>
			</div>
			<div n:if="$salespoints" class="content">
				<p class="title is-6">{_'detail.salespoints'}</p>
				<ul>
					<li n:foreach="$salespoints as $salespoint" n:class="$salespoint['system'] ? 'has-text-grey is-italic'">
						{$salespoint['name']}
						<a n:if="$salespoint['website']" href="{$salespoint['website']}" target="_blank" rel="noopener">{_'detail.website'}</a>
					</li>
				</ul>
			</div>
			<div n:if="$stamp['detail_url']" class="content">
				{_'detail.detailsOn'}
				<a href="{$stamp['detail_url']}" target="_blank" rel="noopener">
					Turistické známky.cz
				</a>
			</div>
		</div>
		<div class="column px-6">
			{if $isCollected}
				{form editSingleStampForm}
					<div class="field">
						{label date, class => "label"/}
						<div class="control">
							{input date, class => "input", data-datepicker => ''}
						</div>
					</div>
					<div class="field">
						{label comment, class => "label"/}
						<div class="control">
							{input comment, class => "input", style=> "height: 225px;"}
						</div>
					</div>

					{input id, value => $stamp['id']}

					<div class="field">
						{input ok, class => "button is-link"}
						<a n:href="toggleCollect!, id => $stamp['id']" class="button is-pulled-right is-danger is-light confirm">
							{_'stamp.uncollect'}
						</a>
					</div>
				{/form}
			{else}
				<a n:href="toggleCollect!, id => $stamp['id']" class="button is-center is-success is-light">
					{_'stamp.collect'}
				</a>
			{/if}
		</div>
	</div>

	<div id="map" class="mx-6" style="height:500px"></div>

	<div class="columns is-multiline px-4">
		<div class="column is-12">
			<p class="title is-3 pt-6">
				{_'detail.nearby'}
			</p>
		</div>
		{foreach $closest as $closestStamp}
			<div class="column is-3">
				{include "../@stampCard.latte", stamp => $closestStamp, collection => $collection}
			</div>
		{/foreach}
	</div>
</div>

{/block}

<script n:syntax="double" n:block=userScript>
	// replace with your own API key
	const API_KEY = 'qsdduL32xP7zUe8rj174i2LSClOB0JlpArnIk3fG_3Y';
	{{var $allStamps = array_merge([$stamp->toArray()], array_values($closest))}}
	{{var $salespointMarkers = array_values(array_filter(array_map(fn($salespoint) => $salespoint->toArray(), $salespoints), fn($salespoint) => $salespoint['lat'] !== null && $salespoint['lng'] !== null))}}
	new StampMap('map', {{$allStamps}}, {{$collection}}, {{$stamp['lat']}}, {{$stamp['lng']}}, {{$baseUrl}}, API_KEY, {{$salespointMarkers}});
</script>
