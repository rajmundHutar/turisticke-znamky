{* Standalone layout for 4xx error pages, same look as 500.phtml; colours from the theme tokens (#53) *}
<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="utf-8">
	<meta name="robots" content="noindex">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="theme-color" content="#161819">
	<title>{include title|stripHtml} | {_'general.turistStampsTitle'}</title>
	<link rel="stylesheet" href="{asset('css/theme.css')}">

	<style>
		html { background: var(--tz-bg) }
		#nette-error { all: initial; position: absolute; top: 0; left: 0; right: 0; height: 70vh; min-height: 400px; display: flex; align-items: center; justify-content: center; z-index: 1000 }
		#nette-error div { all: initial; max-width: 550px; background: var(--tz-bg); color: var(--tz-text-body); display: block }
		#nette-error h1 { all: initial; font: 600 40px/1.1 var(--tz-font); color: var(--tz-text); display: block; margin: 40px 24px }
		#nette-error p { all: initial; font: 18px/1.5 var(--tz-font); color: inherit; margin: 24px; display: block }
		#nette-error a { color: var(--tz-accent-text) }
		#nette-error small { color: var(--tz-text-muted) }
	</style>
</head>

<body>
<div id="nette-error">
	<div>
		{include content}
	</div>
</div>
</body>
</html>
