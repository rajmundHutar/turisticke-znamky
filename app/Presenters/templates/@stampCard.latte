{* the area stops redrawing every stamp of an invalidated 'stamps' area, only the invalidated stamp-<id> is sent *}
{snippetArea stampArea}
{snippet "stamp-{$stamp['id']}"}
{var $isCollected = $collection[$stamp['id']] ?? null}
<div class="card" id="stamp-{$stamp['id']}">

    <div n:if="$isCollected" class="ribbon ribbon-top-right">
		<span>
			{_'stamp.collected'}
			{if $collection[$stamp['id']]?->date !== null}
				<br>
				<small class="is-size-7">
					{$collection[$stamp['id']]?->date->format('j. n. Y')}
				</small>
			{/if}
		</span>
    </div>

    {if $user->isLoggedIn()}
        {include "@collectButton.latte", stamp => $stamp, collection => $collection, class => 'button is-white stamp-card-button'}
    {/if}

    <div class="card-image stamp-image">
        <a n:href="Stamp:, id => $stamp['id']">
            <figure n:if="$stamp['image']" class="image">
                <img src="{$baseUrl}/images/stamps/{$stamp['image']}" alt="{$stamp['name']}" loading="lazy">
            </figure>
            <span n:if="!$stamp['image']" class="icon is-large has-text-grey-lighter" title="{_'stamp.noImage'}">
                <i class="fas fa-4x fa-image"></i>
            </span>
        </a>
    </div>
    <div class="card-content">
        <div class="media">
            <div class="media-left">
                <p class="title is-2">{$stamp['id']}</p>
            </div>
        </div>
        <div class="media">
            <div class="media-content">
                <a n:href="Stamp:, id => $stamp['id']">
                    <p class="title is-5">
                        {$stamp['name']}
                    </p>
                </a>
            </div>
        </div>

        <div class="media" n:if="$stamp['distance'] ?? null">
            <p class="media-content has-text-centered" title="{$stamp['distance']|round:0} m">
				<span class="title is-3">
					{$stamp['prettyDistance']}
				</span>
            </p>
        </div>
    </div>
</div>
{/snippet}
{/snippetArea}
