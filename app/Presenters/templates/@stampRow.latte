{var $isCollected = $collection[$stamp['id']] ?? null}

<article class="stamp-row" id="stamp-{$stamp['id']}">
	<a n:href="Stamp:, id => $stamp['id']" class="stamp-row-link">
		<span class="stamp-row-thumb">
			<img n:if="$stamp['image']" src="{$baseUrl}/images/stamps/{$stamp['image']}" alt="{$stamp['name']}" loading="lazy">
			<span n:if="!$stamp['image']" class="icon has-text-grey-lighter" title="{_'stamp.noImage'}">
				<i class="fas fa-2x fa-image"></i>
			</span>
		</span>
		<span class="stamp-row-text">
			<span class="stamp-row-number">#{$stamp['id']}</span>
			<span class="stamp-row-name">{$stamp['name']}</span>
			<span n:if="$isCollected" class="stamp-row-date">{_'stamp.collectedOn'}{if $isCollected->date !== null} {$isCollected->date->format('j. n. Y')}{/if}</span>
		</span>
	</a>

	{if $user->isLoggedIn() && $isCollected}
		<button type="button" class="button stamp-row-button is-success stamp-edit-button" data-stampid="{$stamp['id']}" aria-label="{_'stamp.editInCollection'}" title="{_'stamp.editInCollection'}">
			<span class="icon"><i class="fas fa-check"></i></span>
		</button>
	{elseif $user->isLoggedIn()}
		<a n:href="toggleCollect!, id => $stamp['id']" class="button stamp-row-button" aria-label="{_'stamp.collect'}" title="{_'stamp.collect'}">
			<span class="icon"><i class="fas fa-plus"></i></span>
		</a>
	{/if}

	<dialog n:if="$isCollected" class="modal" data-stampId="{$stamp['id']}"{if $control['editStampForm-' . $stamp['id']]->hasErrors()} data-open{/if}>
		<div class="modal-card">
			<section class="modal-card-body">
				{form "editStampForm-{$stamp['id']}"}
					<div class="field">
						<a n:href="Stamp:, id => $stamp['id']">
							<span class="is-title is-size-3">{$stamp['id']} - {$stamp['name']}</span>
						</a>
					</div>
					<div class="field">
						{label date, class => "label"/}
						<div class="control">
							{input date, class => "input", data-datepicker => ''}
						</div>
						<p n:ifcontent class="help is-danger">{inputError date}</p>
					</div>
					<div class="field">
						{label comment, class => "label"/}
						<div class="control">
							{input comment, class => "input"}
						</div>
					</div>

					{input id, value => $stamp['id']}

					<div class="field">
						{input ok, class => "button is-link"}
						<a n:href="toggleCollect!, id => $stamp['id']"
								class="button is-pulled-right is-danger is-light confirm">
							{_'stamp.uncollect'}
						</a>
					</div>
				{/form}
			</section>
		</div>
		<button class="modal-close is-large" aria-label="{_'general.closeDialog'}"></button>
	</dialog>
</article>
