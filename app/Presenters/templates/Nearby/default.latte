{block menu}
	{control menu}
{/block}

{block content}
<div class="stamp-list-page">

	{* outside the 'stamps' snippet, bundle.js keeps the status across the redraws *}
	<header class="nearby-header">
		<div class="nearby-title">
			<h1 class="title is-4">{_'nearby.title'}</h1>
			<button type="button" class="button nearby-locate js-locate" aria-label="{_'nearby.locateAgain'}" title="{_'nearby.locateAgain'}">
				<span class="icon"><i class="fas fa-crosshairs"></i></span>
			</button>
		</div>
		<p class="nearby-status" id="nearby-status" role="status" data-state="locating" data-locating="{_'nearby.status.locating'}" data-located="{_'nearby.status.located'}" data-denied="{_'nearby.status.denied'}" data-unavailable="{_'nearby.status.unavailable'}" data-timeout="{_'nearby.status.timeout'}" data-unsupported="{_'nearby.status.unsupported'}" data-load-failed="{_'nearby.status.loadFailed'}">
			<span class="nearby-status-dot" aria-hidden="true"></span>
			<span class="nearby-status-text">{_'nearby.status.locating'}</span>
		</p>
		<noscript>
			<p class="notification is-warning is-light">{_'nearby.noScript'}</p>
		</noscript>
	</header>

	<div n:snippet="stamps">
		{* the links keep lat/lng of this request; the counts are redrawn with the snippet after a collect (#71) *}
		<nav n:if="$switchCounts" class="tabs is-toggle is-fullwidth collection-switch" aria-label="{_'form.filter.collection'}">
			<ul>
				<li n:class="$activeFilter === all ? is-active">
					<a n:href="this, filter => all" class="ajax">{_'form.filter.all'}&nbsp;·&nbsp;{$switchCounts['all']|number: 0, ',', "\u{a0}"}</a>
				</li>
				<li n:class="$activeFilter === collected ? is-active">
					<a n:href="this, filter => collected" class="ajax">{_'form.filter.mine'}&nbsp;·&nbsp;{$switchCounts['collected']|number: 0, ',', "\u{a0}"}</a>
				</li>
				<li n:class="$activeFilter === missing ? is-active">
					<a n:href="this, filter => missing" class="ajax">{_'form.filter.missing'}&nbsp;·&nbsp;{$switchCounts['missing']|number: 0, ',', "\u{a0}"}</a>
				</li>
			</ul>
		</nav>
		<p n:if="$switchCounts" class="collection-switch-note text-muted">{_'nearby.countsOf{count}Nearest', ['count' => $switchCounts['all']]}</p>

		<ul n:if="$stamps" class="stamp-rows">
			<li n:foreach="$stamps as $stamp">
				{include "../@stampRow.latte", stamp => $stamp, collection => $collection}
			</li>
		</ul>

		<article n:if="$located && !$stamps" class="message">
			<div class="message-body">{_'general.noItemsFound'}</div>
		</article>

		{* inside 'stamps', so the form action gets lat/lng after the location is known *}
		<div n:snippet="collectSheet">{include "../@collectSheet.latte"}</div>
	</div>

</div>
{/block}

<script n:syntax="double" n:block=userScript>
	document.addEventListener("DOMContentLoaded", () => initNearby());
</script>
