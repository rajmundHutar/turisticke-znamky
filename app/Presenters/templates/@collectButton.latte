{* The "+" / check button of a stamp; the shared collect sheet (@collectSheet.latte) reads its data attributes (#48) *}
{var $collected = $collection[$stamp['id']] ?? null}
<button type="button" n:class="$class, js-collect, $collected ? is-success" data-stamp-id="{$stamp['id']}" data-stamp-number="{$stamp['id']}" data-stamp-name="{$stamp['name']}" data-collected="{$collected ? 1 : 0}" data-date="{$collected?->date?->format('j. n. Y') ?? ''}" data-note="{$collected?->comment ?? ''}" aria-label="{_($collected ? 'stamp.editInCollection' : 'stamp.collect')}" title="{_($collected ? 'stamp.editInCollection' : 'stamp.collect')}">
	<span class="icon"><i n:class="fas, $collected ? fa-check : fa-plus"></i></span>
</button>
