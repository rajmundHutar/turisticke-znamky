parameters:
	feedUrl: "https://turisticke-znamky.cz/api/feeds/tourist-stamps.xml"
	stampsImagesPath: "%appDir%/../www/images/stamps/"

application:
	errorPresenter: Error
	mapping:
		*: App\*Module\Presenters\*Presenter


session:
	expiration: 14 days


di:
	export:
		parameters: no
		tags: no

services:
	router: App\Router\RouterFactory::createRouter

	# Helpers
	translator: App\Helpers\Translator

	# Models
	- App\Models\StampsModel
	- App\Models\ImportModel(%feedUrl%, %stampsImagesPath%)
	- App\Models\UserModel
	- App\Models\CollectionModel
	- App\Models\LoginThrottle(%tempDir%/login-throttle.lock)

	# Controls
	- App\Controls\Menu(@translator)

	# Forms
	formFactory:
		create: App\Forms\FormFactory
		setup:
			- register(@App\Forms\FilterForm)
			- register(@App\Forms\EditStampForm)
			- register(@App\Forms\LoginForm)
	- App\Forms\FilterForm
	- App\Forms\EditStampForm
	- App\Forms\LoginForm
