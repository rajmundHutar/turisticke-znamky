{
	"name": "rajmund-hutar/turisticke-znamky",
	"description": "Turistické známky",
	"type": "project",
	"license": [
		"MIT",
		"BSD-3-Clause",
		"GPL-2.0",
		"GPL-3.0"
	],
	"require": {
		"php": "^8.3",
		"nette/nette": "^3.2",
		"latte/latte": "3.0.16",
		"tracy/tracy": "^2.10"
	},
	"require-dev": {
		"nette/tester": "^v2.5",
		"phpstan/phpstan": "^2",
		"phpstan/phpstan-nette": "^2"
	},
	"scripts": {
		"test": "tester tests -C",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"check": [
			"@phpstan",
			"@test"
		]
	},
	"autoload": {
		"psr-4": {
			"App\\": "app"
		}
	},
	"config": {
		"allow-plugins": {
			"symfony/thanks": false
		},
		"platform": {
			"php": "8.3"
		}
	}
}
